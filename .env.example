# ProjectNova AI - Environment Variables
# Copy to .env for server-side configuration

# Frontend Application Mode
VITE_APP_ENV=development

# Server-Side AI Gateway Configuration (Kept strictly on server; never exposed in VITE_ client bundles)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=4000

# Client-Side Supabase Integration (Safe publishable URL and anon key only; never put service_role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Future Provider Extension Placeholders
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434
