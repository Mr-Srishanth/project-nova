# ==============================================================================
# Environment Configuration Template for: PortfolioHub
# Architecture: Web Application ([object Object], [object Object], [object Object])
# SAFE PLACEHOLDER VALUES ONLY — NEVER COMMIT REAL SECRETS OR KEYS TO GIT
# ==============================================================================

# Execution environment descriptor for client logging and feature flags (Required | client)
# Location: .env (client build)
VITE_APP_ENV=development

# Supabase Project HTTPS REST & GraphQL endpoint URL (Required | client)
# Location: .env (client build)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Client-side safe publishable key protected by database Row-Level Security (RLS) (Required | client)
# Location: .env (client build)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Gateway Provider Engine (e.g. gemini, openai, anthropic) (Optional | server)
# Location: .env (server)
AI_PROVIDER=gemini

# Google Gemini AI API Key for architecture synthesis & code generation (Optional | server)
# Location: .env (server gateway only - NEVER in VITE_ client bundle)
GEMINI_API_KEY=AIzaSy...

# Local AI Gateway server listening port (Optional | server)
# Location: .env (server)
PORT=4000
